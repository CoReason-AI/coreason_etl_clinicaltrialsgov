from datetime import date
from typing import Any, Optional

from coreason_etl_clinicaltrialsgov.schemas import GoldStudy


def transform_gold(
    raw_study: dict[str, Any],
    silver_study: dict[str, Any],
    locations: list[dict[str, Any]],
    sponsors: list[dict[str, Any]],
) -> Optional[dict[str, Any]]:
    """Transform to Gold layer. Returns None if filtered out."""

    valid_statuses = {"RECRUITING", "ACTIVE_NOT_RECRUITING", "COMPLETED", "SUSPENDED", "TERMINATED"}
    overall_status = silver_study.get("overall_status")

    if not overall_status or overall_status.upper() not in valid_statuses:
        return None

    # Years Active
    start = silver_study.get("start_date")
    end = silver_study.get("completion_date")
    years_active = None
    if start and end:
        if isinstance(start, str):
            start = date.fromisoformat(start)
        if isinstance(end, str):
            end = date.fromisoformat(end)
        delta = end - start
        years_active = delta.days / 365.25

    # Extract Raw Fields
    protocol = raw_study.get("protocolSection", {})
    brief_summary = protocol.get("descriptionModule", {}).get("briefSummary")
    eligibility_criteria = protocol.get("eligibilityModule", {}).get("eligibilityCriteria")
    
    geo_countries = list({loc.get("country") for loc in locations if loc.get("country")})
    geo_countries.sort()

    resp_party = protocol.get("sponsorCollaboratorsModule", {}).get("responsibleParty", {})
    responsible_party_type = resp_party.get("type")

    # JSON 1: Structural Attributes
    structural_attributes = {
        "overall_status": overall_status,
        "study_type": silver_study.get("study_type"),
        "allocation": silver_study.get("allocation"),
        "intervention_model": silver_study.get("intervention_model"),
        "primary_purpose": silver_study.get("primary_purpose"),
        "enrollment_count_info": {
            "count": silver_study.get("enrollment_count"),
            "type": silver_study.get("enrollment_type"),
        },
        "sex": silver_study.get("sex"),
        "minimum_age": silver_study.get("min_age"),
        "maximum_age": silver_study.get("max_age"),
        "healthy_volunteers": silver_study.get("accepted_healthy_volunteers"),
        "study_population": silver_study.get("study_population"),
        "healthy_volunteer": silver_study.get("accepted_healthy_volunteers"), # Duplicate as requested
    }

    # JSON 2: Sponsors Details
    lead_sponsor = next((s for s in sponsors if s.get("role") == "LEAD"), None)
    sponsors_details = {
        "leader_sponsor_name": lead_sponsor.get("name") if lead_sponsor else None,
        "leader_sponsor_class": lead_sponsor.get("agency_class") if lead_sponsor else None,
        "responsible_party_type": responsible_party_type
    }

    gold_model = GoldStudy(
        source_id=silver_study.get("source_id"),
        coreason_id=silver_study.get("coreason_id"),
        title=silver_study.get("title"),
        years_active=years_active,
        eligibility_criteria=eligibility_criteria,
        brief_summary=brief_summary,
        geo_countries=geo_countries,
        structural_attributes=structural_attributes,
        sponsors_details=sponsors_details,
    )

    return gold_model.model_dump()
